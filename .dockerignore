# Only runtime configuration is allowed into the context. Everything else in
# config/ is candidate, rollback, audit, recovery, or historical evidence.
config/*
!config/jobsearch_config.yaml
!config/file_config.yaml
!config/job_app_agent_config.yaml
!config/cv_app_agent_config.yaml
!config/litellm_config.yaml

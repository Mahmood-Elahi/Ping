diff --git a/src/scraper/company_careers/adapters/workday.py b/src/scraper/company_careers/adapters/workday.py
index 27c7c36..a09a484 100644
--- a/src/scraper/company_careers/adapters/workday.py
+++ b/src/scraper/company_careers/adapters/workday.py
@@ -1202,2 +1202,5 @@ def _fetch_pages(
-            metadata["total_available"] = enumerated
-            finish_terminal(metadata, complete_reason="natural_terminal_page")
+            # CXS page length is not an authoritative inventory contract.
+            # In particular, an empty response without a provider total must
+            # never authorize absence, even with reviewed employer identity.
+            metadata["stop_reason"] = "missing_authoritative_total"
+            metadata["scan_completeness_reason"] = "missing_authoritative_total"
diff --git a/tests/test_ats_completeness.py b/tests/test_ats_completeness.py
index d9f2e74..67e1426 100644
--- a/tests/test_ats_completeness.py
+++ b/tests/test_ats_completeness.py
@@ -152 +152 @@ class WorkdayCompletenessTests(unittest.TestCase):
-    def test_short_page_without_total_is_natural_terminal_evidence(self):
+    def test_short_page_without_total_cannot_establish_authoritative_completion(self):
@@ -162,3 +162,3 @@ class WorkdayCompletenessTests(unittest.TestCase):
-        self.assertTrue(metadata["scan_complete"])
-        self.assertEqual(metadata["scan_completeness_reason"], "natural_terminal_page")
-        self.assertEqual(metadata["total_available"], 20)
+        self.assertFalse(metadata["scan_complete"])
+        self.assertEqual(metadata["scan_completeness_reason"], "missing_authoritative_total")
+        self.assertIsNone(metadata["total_available"])

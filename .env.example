# Core scraping credentials
LINKEDIN_USERNAME=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Optional alternative LinkedIn auth methods
# LINKEDIN_LI_AT=your_linkedin_li_at_cookie
# LINKEDIN_COOKIES_FILE=/absolute/path/to/linkedin_cookies.json
# LINKEDIN_CHROME_PROFILE_DIR=/absolute/path/to/chrome-profile

# AI providers used by the document generation flow
GOOGLE_API_KEY=your_google_api_key_here
GPT_4O_API=your_openai_key_here
GPT_4_1_API=your_openai_key_here

# Optional search / enrichment
TAVILY_API_KEY=your_tavily_key_here

# API server settings
API_KEY=replace-this-before-sharing
ALLOWED_ORIGIN=http://localhost:3000

# Runtime defaults
GOOGLE_GENAI_USE_VERTEXAI=False
LOG_LEVEL=INFO
